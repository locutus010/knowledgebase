# Kopieren nach .env und ausfüllen. Pflicht sind nur die ersten beiden Werte.

# Datenbank-Passwort. Nur Buchstaben und Ziffern — es landet in einer URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Schlüssel für Sitzungen und Anmeldeflüsse, mindestens 32 Zeichen.
#   openssl rand -hex 32
KB_SECRET_KEY=

# --- Erreichbarkeit -----------------------------------------------------------------
# Ohne Domain: http://localhost:8080 (nur von diesem Rechner aus).
# Mit Domain: DNS auf diesen Server zeigen lassen, dann
#   KB_DOMAIN=wiki.firma.de  KB_BIND=0.0.0.0  KB_HTTP_PORT=80  KB_HTTPS_PORT=443
# Caddy holt das Zertifikat bei Let's Encrypt, Cookies werden als Secure gesetzt.
KB_DOMAIN=
KB_BIND=127.0.0.1
KB_HTTP_PORT=8080
KB_HTTPS_PORT=8443

# Größte Datei, die man hochladen kann (MB). Importe dürfen bis 200 MB groß sein.
KB_MAX_UPLOAD_MB=25

# --- Erster Administrator (optional) ------------------------------------------------
# Wird nur angelegt, solange es noch gar kein Konto gibt. Danach wieder leeren.
# Alternative: docker compose exec app python -m kb create-admin --email … --name …
KB_BOOTSTRAP_ADMIN_EMAIL=
KB_BOOTSTRAP_ADMIN_PASSWORD=

# --- Anmeldung über SSO / OIDC (optional) -------------------------------------------
# Redirect-URI beim Provider eintragen: https://<KB_DOMAIN>/api/v1/auth/oidc/callback
# (ohne Domain: http://localhost:8080/api/v1/auth/oidc/callback)
KB_OIDC_ISSUER=
KB_OIDC_CLIENT_ID=
KB_OIDC_CLIENT_SECRET=
KB_OIDC_BUTTON_LABEL=Firmenkonto
# Claim mit den Gruppen und deren Zuordnung (kommagetrennt). Bleiben beide Listen leer,
# verwaltest du Rollen in der App selbst.
KB_OIDC_GROUPS_CLAIM=groups
KB_OIDC_ADMIN_GROUPS=
KB_OIDC_EDITOR_GROUPS=
KB_OIDC_DEFAULT_ROLE=reader

# --- Sicherung ----------------------------------------------------------------------
# Zielordner auf dem Host (wird angelegt). Alternativ "backups" für ein Docker-Volume,
# z. B. wenn Docker Desktop den Projektordner nicht einbinden darf.
KB_BACKUP_DIR=./backups
KB_BACKUP_TIME=02:30
KB_BACKUP_KEEP_DAYS=14
TZ=Europe/Berlin
